# ─────────────────────────────────────────────────────────
# CryptoPulse configuration template
# Copy this file to ".env" and fill in your real values.
# The real ".env" is git-ignored and will NEVER be committed.
# ─────────────────────────────────────────────────────────

# Comma-separated list of CoinGecko coin IDs to track.
# Find IDs at https://www.coingecko.com (e.g. bitcoin, ethereum, solana).
COINS=bitcoin,ethereum,solana,cardano,dogecoin

# Fiat currency to price coins in (usd, eur, gbp, ...).
VS_CURRENCY=usd

# ─── Email alerts (optional; leave blank to disable) ─────
# For Gmail, create an "App Password": https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-app-password-here
ALERT_TO=youraddress@gmail.com

# Alert rules: "coin:operator:price" separated by commas.
# operator is "above" or "below". Example below alerts when
# bitcoin goes above 80000 OR ethereum drops below 2000.
ALERT_RULES=bitcoin:above:80000,ethereum:below:2000
