# ─── Secrets & local config ──────────────────────────────
# NEVER commit real credentials. Only .env.example (with fake values) is tracked.
.env
*.env
!.env.example

# ─── Generated data & artifacts ──────────────────────────
# (SQLite databases, generated dashboards, and runtime logs stay local)
data/
reports/
logs/

# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ─── Virtual environment ─────────────────────────────────
.venv/
venv/
env/

# ─── IDE / OS noise ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
